# Copy to `.env.local` and fill in values. `.env*` is gitignored.

# -----------------------------------------------------------------------------
# Next.js (required)
# -----------------------------------------------------------------------------
# Convex deployment URL — from `bunx convex dev` output or
# https://dashboard.convex.dev → your deployment → URL
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# -----------------------------------------------------------------------------
# Merchant logos (optional — Logo.dev publishable key, safe for the browser)
# -----------------------------------------------------------------------------
# https://www.logo.dev/dashboard — used for <img src="https://img.logo.dev/...">
NEXT_PUBLIC_LOGO_DEV_PUBLISHABLE_KEY=

# -----------------------------------------------------------------------------
# Convex backend (optional — OCR fallback for scanned PDFs)
# -----------------------------------------------------------------------------
# Used by Convex actions (`convex/lib/firecrawl.ts`). Next.js does not inject this;
# sync to your Convex deployment after adding here:
#   bunx convex env set --from-file .env.local
# or set in the Convex dashboard / `bunx convex env set FIRECRAWL_API_KEY 'fc-...'`
FIRECRAWL_API_KEY=

# -----------------------------------------------------------------------------
# Budgie AI assistant (in-app chat + MCP server)
# -----------------------------------------------------------------------------
# OpenRouter API key — required for the in-app chat at /api/chat.
# Get one at https://openrouter.ai/keys (free models are available).
# NOT required for the MCP server (`bun run mcp`) — MCP clients bring their own LLM.
OPENROUTER_API_KEY=

# Optional: override the default OpenRouter model used by the in-app chat.
# Defaults to anthropic/claude-sonnet-4.5. Any OpenRouter model id works.
# Browse models at https://openrouter.ai/models
AI_DEFAULT_MODEL=

# -----------------------------------------------------------------------------
# Observability (zero-code, configured at OpenRouter — not via env)
# -----------------------------------------------------------------------------
# Budgie uses OpenRouter's "Broadcast" feature (https://openrouter.ai/docs/guides/features/broadcast)
# to fan every LLM call (request, response, token usage, cost, latency, tool
# calls) out to one or more observability destinations as OpenTelemetry traces.
#
# Recommended setup:
#   1. Sign up for Langfuse (https://langfuse.com or self-host). Get your
#      OTLP endpoint + public/secret key from Project Settings → Observability.
#   2. In your OpenRouter dashboard → Settings → Observability, toggle on
#      "Enable Broadcast" and add Langfuse as a destination with your keys.
#   3. Every chat call from /api/chat will now appear as a trace in Langfuse
#      with full input/output, tool usage, cost, and timing — without any
#      code changes in this repo.
#
# Optional second destination: add Braintrust for prompt evaluation workflows
# alongside (not instead of) Langfuse. Broadcast supports multi-destination.
